#!/bin/bash
#
# nvim-anywhere - use nvim whenever, wherever
# Author: Chris Knadler and very-cool-guy
# Homepage: https://www.github.com/Very-cool-guy/nvim-anywhere
#
# Open a temporary file with nvim. Once nvim is closed, copy the contents of that
# file to the system clipboard.

set -e

###
# defs
###

err() { echo -e "$@" 1>&2; }

require_file_exists() {
  if [ ! -e "$1" ]; then
    err "$1 does not exist. ${*:2}"
    exit 1
  fi
}

###
# opts
###

while getopts ":v" opt; do
  case "$opt" in
    v) set -x ;;
    \?) echo "Invalid option: -$OPTARG" >&2 ;;
  esac
done

###
# run
###

AW_PATH=$HOME/.nvim-anywhere
# $TMPDIR is per-user on macOS; fall back to /tmp on Linux
TMPFILE_DIR="${TMPDIR:-/tmp}/nvim-anywhere"
TMPFILE=$TMPFILE_DIR/doc-$(date +"%y%m%d%H%M%S")
NVIM_OPTS=(+star)

# Use ~/.gvimrc.min or ~/.vimrc.min if one exists
NVIMRC_PATH=("$HOME/.config/nvim/init.vim" "$HOME/.config/nvim/init.lua")

for nvimrc_path in "${NVIMRC_PATH[@]}"; do
    if [ -f "$nvimrc_path" ]; then
        NVIM_OPTS+=(-u "$nvimrc_path")
        break
    fi
done

mkdir -p "$TMPFILE_DIR"
chmod 700 "$TMPFILE_DIR"
touch "$TMPFILE"

# Linux
if [[ $OSTYPE == "linux-gnu" ]]; then
  chmod o-r "$TMPFILE" # Make file only readable by you
  emu_path=$(cat "$AW_PATH/.path")
  "$emu_path" -e bash -c "nvim ${NVIM_OPTS[@]} $TMPFILE"
  xclip -selection clipboard < "$TMPFILE"

# OSX
elif [[ $OSTYPE == "darwin"* ]]; then
  # if there is no path file, it must have been deleted or the installer failed
  require_file_exists "$AW_PATH/.path" \
    "Please reinstall nvim-anywhere."

  app=$(osascript "$AW_PATH/script/current_app.scpt")
  nvim_path=$(head -n 1 "$AW_PATH/.path")
  emu_path=$(tail -n 1 "$AW_PATH/.path")

  require_file_exists "$nvim_path" \
    "nvim must have been moved or uninstalled.\nPlease make sure it is" \
    "available in your path and then reinstall nvim-anywhere."

  "$emu_path" -e bash -c "$nvim_path ${NVIM_OPTS[@]} $TMPFILE"

  # LANG is set explicitly for UTF-8 clipboard compatibility; remove if it causes
  # issues with non-English locales.
  LANG=en_US.UTF-8 pbcopy < "$TMPFILE"
  # Strip quotes from app name to prevent osascript injection
  osascript -e "activate application \"${app//\"/}\""
fi
